# --- Developer Center → your app → Basic Information -------------------------
MONDAY_SIGNING_SECRET=replace-me-signing-secret   # verifies action + remote-options JWTs
MONDAY_CLIENT_SECRET=replace-me-client-secret     # verifies item-view session tokens; also the OAuth client secret
MONDAY_CLIENT_ID=replace-me-client-id

# --- OAuth -------------------------------------------------------------------
# Public URL of this service. Enables the JWT audience check and derives the redirect URI.
PUBLIC_BASE_URL=https://docugen.example.com
# Override only if the registered callback differs from <PUBLIC_BASE_URL>/oauth/callback.
# MONDAY_REDIRECT_URI=https://docugen.example.com/oauth/callback
# Must be a subset of the scopes enabled in the Developer Center.
MONDAY_SCOPES=me:read boards:read boards:write assets:read
# Where per-account tokens are stored (0600 JSON). Use secure storage in production.
# DOCUGEN_TOKEN_STORE=./.tokens.json
# Set to 1 only for the older non-expiring OAuth flow (no PKCE, no refresh).
# MONDAY_OAUTH_LEGACY=1

# --- Single-account development shortcut -------------------------------------
# Used only when no OAuth token is stored for the account. Leave empty for real OAuth.
MONDAY_API_TOKEN=

# --- Paths / offline mode ----------------------------------------------------
# DOCUGEN_TEMPLATE_DIR=./templates
# DOCUGEN_OUTPUT_DIR=./output
# DOCUGEN_FAKE_MONDAY=1
